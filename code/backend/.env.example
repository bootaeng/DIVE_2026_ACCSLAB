# 부산도시철도 OpenAPI 서비스키 (data.humetro.busan.kr / 공공데이터포털에서 발급)
# 문화행사정보(open_api_eventinfo.tnn)와 장애인편의시설정보(open_api_convenience.tnn)에 공용으로 사용
# 발급받은 실제 키는 .env 파일에만 넣으세요 (예시 파일에 실제 키를 커밋하지 않기)
HUMETRO_API_KEY=your_humetro_api_key_here

# (하위호환) HUMETRO_API_KEY가 없으면 이 키를 대신 사용
CULTURE_EVENT_API_KEY=your_humetro_api_key_here

# 네이버 지역검색 API (developers.naver.com > 애플리케이션 등록 > 검색 API 사용 설정)
# 로컬 넛지 쿠폰의 역 주변 실존 상점 검색에 사용 — 없으면 템플릿 상호로 폴백
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# AI 여행 어시스턴트 (assistant_service.py — RAG 챗봇)
# NVIDIA_API_KEY: build.nvidia.com 에서 발급 (필수 — LLM 답변·임베딩 재랭킹)
# SERPER_API_KEY: serper.dev 에서 발급 (선택 — 웹 검색 근거; 없으면 내부 데이터 전용 모드)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key
SERPER_API_KEY=

# 카카오맵 JS 키 (developers.kakao.com > 앱 생성 > 앱 키 > JavaScript 키)
# 여행 일정 동선 지도 시각화에 사용. 플랫폼(Web)에 http://localhost:5173 등록 필요
KAKAO_MAP_JS_KEY=your_kakao_map_js_key

# 카카오 REST API 키 (developers.kakao.com > 앱 키 > REST API 키 + 카카오모빌리티 내비 API 활성화)
# 일정 구간별 실도로 거리·이동시간 계산(/api/leg-times)에 사용 — 없으면 직선거리 추정으로 폴백
KAKAO_REST_API_KEY=your_kakao_rest_api_key
